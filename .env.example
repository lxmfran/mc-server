DISCORD_TOKEN=your_discord_token_here
SCRIPT_PATH=/absolute/path/to/your/firewall_rules.sh

# Discord channel ID where bot commands are accepted (leave 0 to allow all channels)
ALLOWED_CHANNEL_ID=0

# Discord role name required to run bot commands (leave empty to allow everyone)
ADMIN_ROLE_NAME=

# Comma-separated player→domain mappings for the DDNS identity check
# Format: PlayerName=their.ddns.net,OtherPlayer=other.ddns.net
PLAYER_DOMAINS=User1=user1.ddns.net,User2=user2.ddns.net
